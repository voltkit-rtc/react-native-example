{
  "name": "@voltkit-rtc/example-react-native",
  "version": "0.1.0",
  "private": true,
  "description": "VoltKit RTC with React Native and Expo (a development build, Android tested, iOS preview): the docs' video call and audio room, plus the in-app scenario runner of @voltkit-rtc/react-native's device tests.",
  "main": "index.ts",
  "scripts": {
    "android": "expo run:android",
    "prebuild:android": "expo prebuild --platform android --clean --no-install",
    "start": "expo start --dev-client",
    "token-server": "node server/token-server.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test src/e2e/__tests__/"
  },
  "dependencies": {
    "@voltkit-rtc/client": "^0.9.12",
    "@voltkit-rtc/react": "^0.1.1",
    "@voltkit-rtc/react-native": "^0.1.0",
    "expo": "58.0.19",
    "expo-build-properties": "58.0.11",
    "expo-dev-client": "58.0.15",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "react-native-webrtc": "155.0.1"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "typescript": "6.0.3"
  }
}
